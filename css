body{
  margin: 0;
  font-family: Arial;
  background-color: white;
  text-align: center;
}
header{
  background-color: #233923;
  color: white;
  padding: 20px;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
header h1{
  font-size: 25px;
  margin: 0;
}
nav{
  display: flex;
  flex-direction: row;
  gap: 20px;
}
nav a{
  color: white;
  text-decoration: none;
  font-size: 16px;

}
nav a:hover{
  color: yellow;

}
main{
  padding: 30px;
  

}
main h2{
  color: #233923;
  font-size: 30px;
  
}
.gallery{
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 25px;
}
.card{
  background-color: white;
  width: 250px;
  border-radius: 12px;
  box-shadow: 0 3px 10px;
  display: flex;
  padding: 15px;
  flex-direction: column;
}
.card img{
  width: 100%;
  height: 170px;
  object-fit: cover;
  border-radius: 8px;

}
.card h3{
color: #233923;
font-size: 16px;
margin-top: 5px;
}
footer{
  background-color: #233923;
  color: white;
  padding: 15px;
  display: flex;
  flex-direction: row;
  text-align: center;
}
footer p{
  text-align: center;
}
